# Django
# CRITICAL: Generate a strong random SECRET_KEY using:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never use the default value below in any environment.
SECRET_KEY=change-this-to-a-long-random-string-with-min-50-chars

# Debug mode — MUST be False in production
DEBUG=True

# Comma-separated list of allowed hosts (no wildcard in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — PostgreSQL is REQUIRED for production
# For quick local testing without Postgres installed, set USE_SQLITE=True
# PRODUCTION MUST USE POSTGRESQL: money fields, concurrency, and constraints
# depend on Postgres behavior. SQLite is development-only.
USE_SQLITE=False
DB_NAME=vi_agri_science
DB_USER=vi_agri_user
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

# CORS — list of frontend origins allowed to make cross-origin requests
# Production: set to your actual frontend domain only
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF — comma-separated list of origins allowed to submit forms
# Used when frontend is on a different origin than the backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_COOKIE_SAMESITE=Lax
CORS_ALLOW_CREDENTIALS=True

# JWT refresh cookie. It is HttpOnly in application code and is never exposed
# to frontend JavaScript. Use Secure=True with HTTPS in production.
JWT_REFRESH_COOKIE_NAME=via_refresh
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax

# JWT token lifetimes
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Business identity — not hardcoded in templates
BUSINESS_NAME=VI Agri Science
BUSINESS_TAGLINE=Planting dreams, harvesting life
BUSINESS_ADDRESS=No.27, Block No.9, Main Road, Auto Nagar, Hyderabad, Rangareddy, Telangana - 500070

# ============================================================================
# PRODUCTION SECURITY SETTINGS — Only enable in production with HTTPS/SSL
# ============================================================================
# All of these should be False in development/testing to avoid breaking
# automated tests and local development workflows.

# Redirect all HTTP requests to HTTPS
# REQUIRED for production, MUST be False for development/tests
SECURE_SSL_REDIRECT=False

# Set secure flag on session cookies (requires HTTPS)
# REQUIRED for production, MUST be False for development/tests
SESSION_COOKIE_SECURE=False

# Set secure flag on CSRF cookies (requires HTTPS)
# REQUIRED for production, MUST be False for development/tests
CSRF_COOKIE_SECURE=False

# HTTP Strict-Transport-Security header (seconds)
# Set to 31536000 (1 year) in production; 0 disables HSTS
# Do NOT enable in development/tests
SECURE_HSTS_SECONDS=0

# Include subdomains in HSTS
# Only set to True when SECURE_HSTS_SECONDS > 0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Preload in HSTS preload list (irreversible, production-only)
# Only set to True in final production deployment with confidence
SECURE_HSTS_PRELOAD=False

# ============================================================================
# PRODUCTION CONFIGURATION GUIDE
# ============================================================================
#
# To deploy to production:
#
# 1. Generate a new SECRET_KEY:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# 2. Set environment variables:
#    SECRET_KEY=<generated-key>
#    DEBUG=False
#    ALLOWED_HOSTS=your-domain.com,www.your-domain.com
#    
#    # PostgreSQL (required)
#    USE_SQLITE=False
#    DB_NAME=<production-db-name>
#    DB_USER=<production-db-user>
#    DB_PASSWORD=<strong-password>
#    DB_HOST=<rds-endpoint-or-postgres-host>
#    DB_PORT=5432
#    
#    # Frontend & CORS
#    CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
#    CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
#    CORS_ALLOW_CREDENTIALS=True
#    JWT_REFRESH_COOKIE_SECURE=True
#    JWT_REFRESH_COOKIE_SAMESITE=Lax
#    
#    # HTTPS/Security (only after SSL certificate is active)
#    SECURE_SSL_REDIRECT=True
#    SESSION_COOKIE_SECURE=True
#    CSRF_COOKIE_SECURE=True
#    SECURE_HSTS_SECONDS=31536000
#    SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#    SECURE_HSTS_PRELOAD=False  # Set to True only after testing HSTS
#
# 3. Run migrations:
#    python manage.py migrate
#
# 4. Verify production readiness:
#    python manage.py check --deploy
#
# 5. Deploy with a production WSGI server (Gunicorn, uWSGI, etc.)
#    with proper TLS/SSL termination.
#
# 6. Set up automated backups for PostgreSQL database.
#
# 7. Monitor logs and error rates in production.
