# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). For quick local testing without Postgres installed,
# you may temporarily set USE_SQLITE=True — but production MUST use Postgres.
USE_SQLITE=False
DB_NAME=vi_agri_science
DB_USER=vi_agri_user
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetime (minutes / days)
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Business info (configurable, not hard-coded in templates/components)
BUSINESS_NAME=VI Agri Science
BUSINESS_TAGLINE=Planting dreams, harvesting life
BUSINESS_ADDRESS=No.27, Block No.9, Main Road, Auto Nagar, Hyderabad, Rangareddy, Telangana - 500070
